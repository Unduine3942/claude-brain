# Normalize to LF in the repo; check out native on Windows.
* text=auto

*.py   text eol=lf
*.toml text eol=lf
*.yaml text eol=lf
*.yml  text eol=lf
*.md   text eol=lf
*.sql  text eol=lf
*.json text eol=lf

# Windows-only launchers need CRLF to behave in cmd.exe.
*.bat  text eol=crlf
*.cmd  text eol=crlf

*.db   binary
*.png  binary
*.ico  binary
